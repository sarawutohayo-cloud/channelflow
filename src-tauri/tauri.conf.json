{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChannelFlow",
  "version": "0.1.0",
  "identifier": "com.channelflow.publisher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ChannelFlow", "width": 1280, "height": 820, "minWidth": 1050, "minHeight": 700, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "AI YouTube Publisher for multiple channels"
  }
}
